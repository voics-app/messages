# Development-only values for `make dev`. Copy to `.env`; never commit real secrets.
DISCORDY_ENV=local
LOG_LEVEL=info
BIND_ADDR=0.0.0.0:8082
INTERNAL_SERVICE_TOKEN=dev-internal-token
# Ed25519 public key (PEM). Literal \n sequences are accepted so it fits on one line.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_THE_API_DEV_PUBLIC_KEY\n-----END PUBLIC KEY-----"
SNOWFLAKE_WORKER_ID=64
KAFKA_BROKERS=localhost:19092
SCYLLA_NODES=localhost:9042
SCYLLA_KEYSPACE=discordy
# Atomic read state lives in a distinct vnode keyspace on the same cluster.
SCYLLA_READ_STATE_KEYSPACE=discordy_reads
API_INTERNAL_URL=http://localhost:8080
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=discordy
MINIO_SECRET_KEY=discordy-dev-secret
MINIO_BUCKET_ATTACHMENTS=discordy-attachments
CDN_PUBLIC_URL=http://localhost:8000/cdn
CORS_ALLOWED_ORIGINS=null,http://localhost:5173
